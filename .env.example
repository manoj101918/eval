# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=

# Vision model (Groq)
VISION_MODEL=qwen/qwen3.8-27b
# none | default | low | medium | high  (transcription does not need reasoning)
VISION_REASONING_EFFORT=none
# json_schema (strict, constrained) | json_object (schema described in the prompt)
VISION_RESPONSE_FORMAT=json_schema

# Vision calls
VISION_MAX_CONCURRENCY=3
VISION_CALL_TIMEOUT_S=90
VISION_MAX_RETRIES=4
VISION_BACKOFF_BASE_S=1.0
VISION_MAX_TOKENS=8000

# Image preprocessing
IMAGE_MAX_PX=1500
JPEG_QUALITY=80
PDF_RENDER_DPI=200
# Pages below this ink ratio are skipped as blank. Keep it low: a wrongly skipped
# page loses an answer; a wrongly kept one only costs an API call.
BLANK_INK_RATIO=0.0001

# Answer booklet layout
HAS_COVER_PAGE=true
ROLL_NUMBER_PATTERN=[A-Z0-9]{5,15}
