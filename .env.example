# Copy to .env and fill in. Never commit .env.

# Transcription engine: azure (Document Intelligence OCR, default) | groq (vision LLM)
TRANSCRIBE_PROVIDER=azure

# Azure Document Intelligence (portal: resource > Keys and Endpoint)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_MODEL=prebuilt-read
# Free tier (F0) allows 1 request/second: keep 1. Standard (S0) allows 15/second.
AZURE_MAX_CONCURRENCY=1
AZURE_IMAGE_MAX_PX=2400
# Words recognised with less confidence than this are listed as unclear
AZURE_LOW_CONFIDENCE=0.3

# Groq (only when TRANSCRIBE_PROVIDER=groq)
GROQ_API_KEY=

# Grading (Groq text model). Free tier: 8,000 tokens/min, 200,000/day for this model.
GRADING_MODEL=openai/gpt-oss-120b
# low | medium | high (more reasoning = better judgement, more tokens)
GRADING_REASONING_EFFORT=medium
GRADING_RESPONSE_FORMAT=json_schema
GRADING_TEMPERATURE=0.2
GRADING_MAX_CONCURRENCY=2
GRADING_TOKENS_PER_MINUTE=8000
GRADING_MAX_TOKENS=4096

# Vision model (Groq, only when TRANSCRIBE_PROVIDER=groq)
VISION_MODEL=qwen/qwen3.8-27b
# none | default | low | medium | high  (transcription does not need reasoning)
VISION_REASONING_EFFORT=none
# json_object (schema described in the prompt) | json_schema (strict; returned empty
# transcriptions on qwen3.8-27b with reasoning off)
VISION_RESPONSE_FORMAT=json_object

# Vision calls
# Groq free tier: 8,000 tokens/minute for this model (~2-3 pages/minute)
VISION_MAX_CONCURRENCY=2
VISION_CALL_TIMEOUT_S=90
VISION_MAX_RETRIES=4
VISION_RATE_LIMIT_RETRIES=10
# Client-side pacing to stay under the account's limit; 0 disables
VISION_TOKENS_PER_MINUTE=8000
VISION_BACKOFF_BASE_S=1.0
# Largest page seen so far needed ~650 output tokens
VISION_MAX_TOKENS=2048

# Image preprocessing
IMAGE_MAX_PX=1500
JPEG_QUALITY=80
PDF_RENDER_DPI=200
# Pages below this ink ratio are skipped as blank. Keep it low: a wrongly skipped
# page loses an answer; a wrongly kept one only costs an API call.
BLANK_INK_RATIO=0.0001

# auto = detect once per script with the vision model; or 0/90/180/270 (counter-clockwise)
PAGE_ROTATION=auto

# Answer booklet layout
HAS_COVER_PAGE=true
ROLL_NUMBER_PATTERN=[A-Z0-9]{5,15}
